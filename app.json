{
  "expo": {
    "name": "Pouch",
    "slug": "Pouch",
    "scheme": "pouch",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pouch.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E3B2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-file-system",
      "expo-sharing"
    ]
  }
}
